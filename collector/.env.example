# From https://console.cloudinary.com/ -> Dashboard -> API Keys
# Copy this file to .env.local and fill in all three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Basic auth guarding the collector UI and /api/ingest.
# /api/media stays open — the board and agents read it.
COLLECTOR_USER=
COLLECTOR_PASSWORD=
