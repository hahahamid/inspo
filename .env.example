# From https://console.cloudinary.com/ -> Dashboard -> API Keys.
# Cloudinary stores the media AND the metadata index, so these are the only
# credentials the app needs. There is no database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Basic auth guarding /collector and /api/ingest.
# The board at / and the /api/media feed stay public.
COLLECTOR_USER=
COLLECTOR_PASSWORD=
